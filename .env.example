# Copy to .env (git-ignored). See docs/11-claude-connection-and-cost.md §1.1.

# api_key | claude_cli_login | observer | bedrock | vertex
AUTH_MODE=claude_cli_login

# Required only when AUTH_MODE=api_key
ANTHROPIC_API_KEY=

# Model per class; agents pick a class in agents/*.md (docs/11 §2.2)
MODEL_CHEAP=claude-haiku-5-5
MODEL_MID=claude-haiku-5-5
MODEL_STRONG=claude-sonnet-5-5

# Run limits: total budget per run, max steps the CEO may plan, steps running at once.
# Per-agent turn and budget limits live in agents/*.md.
RUN_BUDGET_USD=2
PLAN_SIZE_CAP=6
MAX_CONCURRENT_STEPS=3

# Storage (SQLite via node:sqlite) and per-run workspaces
DB_PATH=data/claudestra.db
WORKSPACES_DIR=workspaces

# Server (local only; do not change HOST to 0.0.0.0 before deploy hardening, docs/12)
HOST=127.0.0.1
PORT=8787

# Optional: path to a specific Claude Code executable for the SDK
CLAUDE_CODE_PATH=
