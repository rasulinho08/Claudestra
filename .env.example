# Copy to .env (git-ignored). See docs/11-claude-connection-and-cost.md §1.1.

# api_key | claude_cli_login | observer | bedrock | vertex | demo | gemini | meta | openai_compat
# meta          = Meta Muse API (api.meta.ai); set META_API_KEY below
# openai_compat = any OpenAI-compatible Chat Completions API (OpenRouter, DeepSeek, Groq, Ollama, LM Studio)
# demo   = try the whole app with simulated agents: no AI, no login, $0 (DEMO_SPEED=2 makes it faster)
# gemini = Google Gemini API (free key at aistudio.google.com); set GEMINI_API_KEY below
AUTH_MODE=claude_cli_login

# Required only when AUTH_MODE=api_key
ANTHROPIC_API_KEY=

# Only for AUTH_MODE=meta (Meta's developer console). One model for all agents, or per class.
META_API_KEY=
META_MODEL=muse-spark-1.3
# META_MODEL_STRONG= / META_MODEL_MID= / META_MODEL_CHEAP=
# Prices per 1M tokens (for budgets and the Costs page); copy them from Meta's pricing page
META_PRICE_INPUT_PER_M=0
META_PRICE_OUTPUT_PER_M=0

# Only for AUTH_MODE=openai_compat. Pick a provider preset (sets the URL):
#   openrouter | groq | deepseek (need OPENAI_API_KEY)   ollama | lmstudio (free, offline, no key; one step at a time)
# or leave it empty and set OPENAI_BASE_URL to any OpenAI-compatible /v1 endpoint.
OPENAI_PROVIDER=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PRICE_INPUT_PER_M=0
OPENAI_PRICE_OUTPUT_PER_M=0

# Only for AUTH_MODE=gemini. Models per class (defaults shown); prices per 1M tokens only matter on a paid key.
GEMINI_API_KEY=
GEMINI_MODEL_STRONG=gemini-3.8-flash
GEMINI_MODEL_MID=gemini-3.8-flash
GEMINI_MODEL_CHEAP=gemini-3.5-flash-lite
GEMINI_PRICE_INPUT_PER_M=0
GEMINI_PRICE_OUTPUT_PER_M=0

# Quota-aware waiting (Gemini / Meta / OpenAI-compatible): on 429 or "overloaded" every step waits and continues,
# up to this many seconds in total per request (default 600). Daily quotas fail at once.
QUOTA_MAX_WAIT_SEC=
# Optional pacing: at most N requests per minute per engine (e.g. GEMINI_RPM=10 on the free tier). Empty = no pacing.
GEMINI_RPM=
META_RPM=
OPENAI_RPM=

# Model per class for the balanced profile; agents pick a class in agents/*.md (docs/11 §2.2)
MODEL_CHEAP=claude-haiku-5-5
MODEL_MID=claude-haiku-5-5
MODEL_STRONG=claude-sonnet-5-5
# The max profile uses MODEL_MAX_STRONG (default claude-opus-5-5) and MODEL_MAX_MID (default MODEL_STRONG)

# Defaults for the prompt box (each run can override): eco | balanced | max, manual | smart | auto
DEFAULT_PROFILE=balanced
DEFAULT_APPROVAL_MODE=smart

# Budget per run for each profile, and the max steps the CEO may plan
ECO_BUDGET_USD=0.5
RUN_BUDGET_USD=2
MAX_BUDGET_USD=8
ECO_PLAN_SIZE_CAP=3
PLAN_SIZE_CAP=6
MAX_PLAN_SIZE_CAP=10

# Spending caps across runs (leave empty for none); new runs are refused once reached
DAILY_BUDGET_USD=
MONTHLY_BUDGET_USD=

# Orchestration
MAX_CONCURRENT_STEPS=3
MAX_LOOP_ITERATIONS=2
MAX_RETRIES_PER_STEP=1
# Patterns that always ask, even in auto mode (comma-separated; default covers git push, rm -rf, sudo, MCP writes)
NEVER_AUTO=
# OS sandbox for Bash where supported (Linux/macOS): auto | on | off
OS_SANDBOX=auto

# Cross-run memory (notes + recall of related earlier runs): on | off
MEMORY=on

# Login. Leave empty for local use. Set a long random AUTH_TOKEN before exposing the app (HOST other than 127.0.0.1);
# more users: npm run user -- add NAME owner|operator|viewer
AUTH_TOKEN=
# Shared secret for Claude Code observer hooks when login is on (also set CLAUDESTRA_HOOKS_SECRET for the hook script)
HOOKS_SECRET=

# Results (docs/07): "Try it" preview port (default PORT+1, 0 = off) and its public URL when deployed behind a proxy
PREVIEW_PORT=
PREVIEW_URL=
# Extra browser origins allowed to call the API (default: the Vite dev server on :5173)
WEB_ORIGINS=
# Extra host names the browser may use while the server listens on 127.0.0.1 (DNS-rebinding guard)
ALLOWED_HOSTS=

# Secrets for apps in integrations.json (only the ones you use).
# GITHUB_TOKEN is also used by the "⬆ GitHub" button (fine-grained: Contents + Administration read/write; classic: repo)
GITHUB_TOKEN=
DATABASE_URL=
BRAVE_API_KEY=

# Storage (SQLite via node:sqlite) and per-run workspaces
DB_PATH=data/claudestra.db
WORKSPACES_DIR=workspaces

# Server (local only; do not change HOST to 0.0.0.0 before deploy hardening, docs/12)
HOST=127.0.0.1
PORT=8787

# Optional: path to a specific Claude Code executable for the SDK
CLAUDE_CODE_PATH=
