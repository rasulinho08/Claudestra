# Copy to .env (git-ignored). See docs/11-claude-connection-and-cost.md §1.1.

# api_key | claude_cli_login | observer | bedrock | vertex | demo
# demo = try the whole app with simulated agents: no AI, no login, $0 (DEMO_SPEED=2 makes it faster)
AUTH_MODE=claude_cli_login

# Required only when AUTH_MODE=api_key
ANTHROPIC_API_KEY=

# Model per class for the balanced profile; agents pick a class in agents/*.md (docs/11 §2.2)
MODEL_CHEAP=claude-haiku-5-5
MODEL_MID=claude-haiku-5-5
MODEL_STRONG=claude-sonnet-5-5
# The max profile uses MODEL_MAX_STRONG (default claude-opus-5-5) and MODEL_MAX_MID (default MODEL_STRONG)

# Defaults for the prompt box (each run can override): eco | balanced | max, manual | smart | auto
DEFAULT_PROFILE=balanced
DEFAULT_APPROVAL_MODE=smart

# Budget per run for each profile, and the max steps the CEO may plan
ECO_BUDGET_USD=0.5
RUN_BUDGET_USD=2
MAX_BUDGET_USD=8
ECO_PLAN_SIZE_CAP=3
PLAN_SIZE_CAP=6
MAX_PLAN_SIZE_CAP=10

# Spending caps across runs (leave empty for none); new runs are refused once reached
DAILY_BUDGET_USD=
MONTHLY_BUDGET_USD=

# Orchestration
MAX_CONCURRENT_STEPS=3
MAX_LOOP_ITERATIONS=2
MAX_RETRIES_PER_STEP=1
# Patterns that always ask, even in auto mode (comma-separated; default covers git push, rm -rf, sudo, MCP writes)
NEVER_AUTO=
# OS sandbox for Bash where supported (Linux/macOS): auto | on | off
OS_SANDBOX=auto

# Cross-run memory (notes + recall of related earlier runs): on | off
MEMORY=on

# Login. Leave empty for local use. Set a long random AUTH_TOKEN before exposing the app (HOST other than 127.0.0.1);
# more users: npm run user -- add NAME owner|operator|viewer
AUTH_TOKEN=
# Shared secret for Claude Code observer hooks when login is on (also set CLAUDESTRA_HOOKS_SECRET for the hook script)
HOOKS_SECRET=

# Secrets for apps in integrations.json (only the ones you use)
GITHUB_TOKEN=
DATABASE_URL=
BRAVE_API_KEY=

# Storage (SQLite via node:sqlite) and per-run workspaces
DB_PATH=data/claudestra.db
WORKSPACES_DIR=workspaces

# Server (local only; do not change HOST to 0.0.0.0 before deploy hardening, docs/12)
HOST=127.0.0.1
PORT=8787

# Optional: path to a specific Claude Code executable for the SDK
CLAUDE_CODE_PATH=
