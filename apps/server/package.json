{
  "name": "@claudestra/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "user": "tsx scripts/user.ts",
    "dev:watch": "tsx watch --clear-screen=false src/main.ts",
    "demo": "tsx src/main.ts --demo"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@claudestra/protocol": "*",
    "@hono/node-server": "^1.19.6",
    "hono": "^4.10.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "tsx": "^4.20.6"
  }
}
