{
  "github": {
    "description": "GitHub (official remote MCP server): search code, read files, issues and pull requests.",
    "type": "http",
    "url": "https://api.githubcopilot.com/mcp/",
    "headers": {
      "Authorization": "Bearer ${GITHUB_TOKEN}"
    },
    "readTools": [
      "search_code",
      "search_repositories",
      "get_file_contents",
      "list_issues",
      "get_issue",
      "list_pull_requests"
    ]
  },
  "postgres": {
    "description": "Read-only PostgreSQL access for the data analyst.",
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-postgres",
      "${DATABASE_URL}"
    ],
    "readTools": [
      "query"
    ]
  },
  "brave-search": {
    "description": "Brave web search, an alternative to the built-in WebSearch.",
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-brave-search"
    ],
    "env": {
      "BRAVE_API_KEY": "${BRAVE_API_KEY}"
    },
    "readTools": [
      "brave_web_search"
    ]
  },
  "apify": {
    "description": "Apify (free plan: monthly credits): ready-made scrapers for Google Maps, websites, LinkedIn, Instagram and more, plus a web browser for agents. Key: console.apify.com → Settings → API & Integrations.",
    "type": "http",
    "url": "https://mcp.apify.com/?tools=actors,docs,apify/rag-web-browser",
    "headers": {
      "Authorization": "Bearer ${APIFY_TOKEN}"
    },
    "readTools": [
      "search-actors",
      "fetch-actor-details",
      "search-apify-docs",
      "fetch-apify-docs",
      "apify-slash-rag-web-browser"
    ]
  },
  "media": {
    "description": "Built-in: render SVG post cards to PNG (free, local) and generate pictures with Gemini (free tier, needs GEMINI_API_KEY; optional).",
    "type": "stdio",
    "command": "${CLAUDESTRA_NODE}",
    "args": [
      "${CLAUDESTRA_ROOT}/apps/server/mcp/media.mjs"
    ],
    "env": {
      "CLAUDESTRA_WORKSPACE": "${CLAUDESTRA_WORKSPACE}",
      "GEMINI_API_KEY": "${GEMINI_API_KEY:-}",
      "GEMINI_IMAGE_MODEL": "${GEMINI_IMAGE_MODEL:-}",
      "MEDIA_MAX_IMAGES": "${MEDIA_MAX_IMAGES:-6}"
    },
    "readTools": [
      "render_png"
    ]
  },
  "social": {
    "description": "Built-in: post to Instagram, LinkedIn, X (and more) through Postiz. Every post needs your approval. Key: Postiz → Settings → Public API.",
    "type": "stdio",
    "command": "${CLAUDESTRA_NODE}",
    "args": [
      "${CLAUDESTRA_ROOT}/apps/server/mcp/social.mjs"
    ],
    "env": {
      "CLAUDESTRA_WORKSPACE": "${CLAUDESTRA_WORKSPACE}",
      "POSTIZ_API_KEY": "${POSTIZ_API_KEY}",
      "POSTIZ_URL": "${POSTIZ_URL:-https://api.postiz.com/public/v1}"
    },
    "readTools": [
      "list_channels"
    ]
  }
}
